# 复制为 .env.local，在你自己的 Codespaces 中填写。不要把真实密钥提交到 GitHub。
# 完整配置说明：docs/AI_SETUP.md

# ─── 默认：DeepSeek ───
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── 其他 OpenAI 兼容协议服务（三项都要填；模型名称由服务商提供）───
# AI_PROVIDER=compatible
# AI_API_KEY=your-api-key
# AI_BASE_URL=https://your-provider/v1
# AI_MODEL=your-model-name

# ─── 兼容原有 MIMO 配置 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=your-model-name

NEXT_PUBLIC_SITE_URL=http://localhost:3000
